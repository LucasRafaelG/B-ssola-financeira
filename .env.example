# Copie este arquivo para ".env" e preencha os valores.
# O ".env" fica só no seu computador: ele está no .gitignore e nunca vai para o GitHub.

# Painel dashboard.pluggy.ai > sua aplicação
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Id do item MeuPluggy (a conexão com o seu banco)
PLUGGY_ITEM_ID=

# Opcional. "demo" usa transações fictícias e não acessa a Pluggy; vazio ou "real" usa seus dados.
DATA_MODE=

# Planilha do Google Sheets: o ID fica no endereço da planilha, entre /d/ e /edit
SHEET_ID=

# Opcional. Dias buscados na primeira vez, com a planilha vazia (em branco = 90).
DIAS_HISTORICO=
